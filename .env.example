# --- Core ---
NODE_ENV=development
PORT=3000
# Public base URL of the API (used in OpenAPI servers + links)
API_BASE_URL=http://localhost:3000

# --- Database (PostgreSQL 16 + pgvector) ---
# Dev compose maps Postgres to host port 5433 (5432 is often taken locally)
DATABASE_URL=postgresql://childshield:childshield@localhost:5433/childshield?schema=public

# --- Redis (queues, WS pub/sub, tickets, sessions) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=change-me-32-chars-minimum-secret
JWT_REFRESH_SECRET=change-me-too-32-chars-minimum-x
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Realtime ---
# Seconds a single-use WS ticket stays valid
WS_TICKET_TTL=30

# --- SLA clocks (minutes until sla.warning if case not yet triaged) ---
SLA_MINUTES_LOW=1440
SLA_MINUTES_MEDIUM=240
SLA_MINUTES_HIGH=60
SLA_MINUTES_CRITICAL=15

# --- Observability ---
# Leave empty to disable Sentry
SENTRY_DSN=
LOG_LEVEL=info

# --- ML service (internal network only; advisory) ---
ML_SERVICE_URL=http://ml:8000
ML_SERVICE_API_KEY=change-me-internal-api-key

# --- Mail (Mailpit in dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@childshield.local
