{
  "name": "@childshield/mobile",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "sync-ip": "powershell -ExecutionPolicy Bypass -File ../../scripts/sync-lan-ip.ps1",
    "start": "pnpm sync-ip && expo start --dev-client",
    "start:clear": "pnpm sync-ip && expo start --dev-client --clear",
    "start:tunnel": "expo start --dev-client --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint app src"
  },
  "dependencies": {
    "@childshield/shared": "workspace:*",
    "@expo-google-fonts/baloo-2": "^0.3.0",
    "@expo-google-fonts/manrope": "^0.3.0",
    "@expo/metro-runtime": "~57.0.12",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.15",
    "expo-audio": "~57.0.4",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.13",
    "expo-dev-client": "~57.0.14",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-local-authentication": "~57.0.2",
    "expo-router": "~57.0.15",
    "expo-screen-capture": "~57.0.2",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "lottie-web": "^5.13.0",
    "matter-js": "^0.20.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@childshield/config": "workspace:*",
    "@types/matter-js": "^0.20.2",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.7"
  }
}
