    "/cases": {
      "post": {
        "summary": "Anonymous case intake (zero PII required). Returns the public case code.",
        "tags": [
          "cases"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "description": "Anonymous-first intake. Contains zero PII fields by design; free-text description is the only unstructured input.",
                "type": "object",
                "required": [
                  "reporterType",
                  "ageBand",
                  "channel",
                  "incidentType",
                  "description",
                  "consentVersion"
                ],
                "properties": {
                  "reporterType": {
                    "type": "string",
                    "enum": [
                      "CHILD_SELF",
                      "PEER",
                      "CAREGIVER",
                      "PROFESSIONAL",
                      "OTHER"
                    ]
                  },
                  "ageBand": {
                    "type": "string",
                    "enum": [
                      "UNDER_10",
                      "AGE_10_12",
                      "AGE_13_15",
                      "AGE_16_18",
                      "UNKNOWN"
                    ]
                  },
                  "channel": {
                    "type": "string",
                    "enum": [
                      "WEB",
                      "WHATSAPP",
                      "USSD",
                      "SMS"
                    ]
                  },
                  "incidentType": {
                    "type": "string",
                    "enum": [
                      "GROOMING",
                      "SEXTORTION",
                      "BULLYING",
                      "SELF_HARM",
                      "COERCION",
                      "HARMFUL_EXPOSURE",
                      "OTHER"
                    ]
                  },
                  "description": {
                    "minLength": 1,
                    "maxLength": 10000,
                    "type": "string"
                  },
                  "county": {
                    "maxLength": 100,
                    "type": "string"
                  },
                  "consentVersion": {
                    "minLength": 1,
                    "maxLength": 50,
                    "type": "string"
                  },
                  "mediaHashes": {
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "hash",
                        "algorithm"
                      ],
                      "properties": {
                        "hash": {
                          "minLength": 8,
                          "maxLength": 512,
                          "type": "string"
                        },
                        "algorithm": {
                          "type": "string",
                          "enum": [
                            "SHA256",
                            "PDQ",
                            "MD5_LEGACY"
                          ]
                        },
                        "metadata": {
                          "description": "Non-content metadata only (e.g. platform, approximate size). Never storage refs.",
                          "type": "object",
                          "additionalProperties": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "number"
                              },
                              {
                                "type": "boolean"
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "description": "Anonymous-first intake. Contains zero PII fields by design; free-text description is the only unstructured input."
        },
        "responses": {
          "201": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "caseCode",
                    "status",
                    "createdAt"
                  ],
                  "properties": {
                    "caseCode": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "RECEIVED",
                        "TRIAGED",
                        "UNDER_REVIEW",
                        "REFERRED",
                        "IN_PROGRESS",
                        "CLOSED",
                        "REOPENED"
                      ]
                    },
                    "createdAt": {
                      "format": "date-time",
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
