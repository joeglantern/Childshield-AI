{
  "expo": {
    "name": "ChildShield",
    "slug": "childshield",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "childshield",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF6EE"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ke.go.childshield.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ke.go.childshield.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBF6EE"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow ChildShield to use Face ID to unlock the app."
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "638fb9dc-30a1-4f21-8bbc-f47b26eaa5ff"
      }
    }
  }
}
