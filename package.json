{
  "name": "childshield",
  "private": true,
  "version": "0.1.0",
  "description": "ChildShield AI — child online-protection intake and triage platform (Kenya, Phase 1)",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@shopify/react-native-skia",
      "argon2",
      "esbuild",
      "msgpackr-extract",
      "prisma"
    ]
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "openapi:generate": "pnpm --filter @childshield/api openapi:generate",
    "db:migrate": "pnpm --filter @childshield/db migrate:dev",
    "db:generate": "pnpm --filter @childshield/db generate",
    "db:seed": "pnpm --filter @childshield/db seed"
  }
}
